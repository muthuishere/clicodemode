 {
  "id": "cap2-fingerprint-stable",
  "spec": [
   "CAP-2"
  ],
  "description": "identical registries have identical fingerprints",
  "mode": "fingerprint",
  "ops": [
   {
    "name": "a.one",
    "description": "d",
    "side_effects": "none",
    "idempotent": true
   },
   {
    "name": "b.two",
    "description": "d",
    "side_effects": "external"
   }
  ],
  "ops_b": [
   {
    "name": "a.one",
    "description": "d",
    "side_effects": "none",
    "idempotent": true
   },
   {
    "name": "b.two",
    "description": "d",
    "side_effects": "external"
   }
  ],
  "program": "",
  "expect": {
   "fingerprint": "equal"
  }
 },
