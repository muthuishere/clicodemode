  }
 },
 {
  "id": "op4-policy-denial-catchable",
  "spec": [
   "OP-4"
  ],
  "description": "a denial is catchable by the program",
  "ops": [
   {
    "name": "w.write",
    "description": "w",
    "side_effects": "external"
   }
  ],
  "policy": {
   "deny_side_effects": [
    "external"
   ]
  },
  "program": "let m = \"none\"; try { await call(\"w.write\") } catch (e) { m = \"denied\" } m",
  "expect": {
   "result": "denied",
   "calls": {
    "w.write": 0
   },
   "exit": 0
  }
 },
 {
  "id": "op4-policy-consulted-every-call",
  "spec": [
   "OP-4"
  ],
  "description": "the policy is consulted for each call, not once per program",
  "ops": [
   {
    "name": "a.read",
    "description": "r",
    "side_effects": "none",
    "returns": "r"
   },
   {
    "name": "b.write",
    "description": "w",
    "side_effects": "external",
    "returns": "w"
   }
  ],
  "policy": {
   "deny_side_effects": [
    "external"
   ]
  },
  "program": "const out = []; for (const n of [\"a.read\", \"b.write\", \"a.read\"]) { try { out.push(await call(n)) } catch (e) { out.push(\"denied\") } } out",
  "expect": {
   "result": [
    "r",
    "denied",
    "r"
   ],
   "calls": {
    "a.read": 2,
    "b.write": 0
   },
   "exit": 0
  }
 },
