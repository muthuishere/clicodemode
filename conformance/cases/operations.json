 {
  "id": "op4-policy-denies",
  "spec": [
   "OP-4"
  ],
  "description": "a denying policy rejects the call and the handler never runs",
  "ops": [
   {
    "name": "math.add",
    "description": "add",
    "input_schema": {
     "type": "object",
     "properties": {
      "a": {
       "type": "number"
      },
      "b": {
       "type": "number"
      }
     },
     "required": [
      "a",
      "b"
     ]
    },
    "returns": 3
   }
  ],
  "policy": {
   "deny_side_effects": [
    "local"
   ]
  },
  "program": "await call(\"math.add\", {a: 1, b: 2})",
  "expect": {
   "error": {
    "messageContains": "denied"
   },
   "calls": {
    "math.add": 0
   },
   "exit": 1
  }
 },
 {
  "id": "op4-policy-allows-others",
  "spec": [
   "OP-4"
  ],
  "description": "the policy only blocks what it names",
  "ops": [
   {
    "name": "h.read",
    "description": "r",
    "side_effects": "none",
    "returns": "read"
   }
  ],
  "policy": {
   "deny_side_effects": [
    "local",
    "external"
   ]
  },
  "program": "await call(\"h.read\")",
  "expect": {
   "result": "read",
