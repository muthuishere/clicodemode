   "OP-3",
   "CLI-5"
  ],
  "description": "a literal unknown operation is a check error with a did-you-mean hint at the string literal",
  "mode": "check",
  "ops": [
   {
    "name": "health.check",
    "description": "h"
   }
  ],
  "program": "const a = 1\nawait call(\"health.chek\", {})",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 2,
     "col": 12,
     "messageContains": "unknown operation \"health.chek\"",
     "hintContains": "health.check"
    }
   ],
   "exit": 2
  }
 },
