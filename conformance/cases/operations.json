[
 {
  "id": "op1-call-and-ops-equivalent",
  "spec": [
   "OP-1"
  ],
  "description": "call(name, args) and ops.path(args) are equivalent",
  "ops": [
   {
    "name": "math.add",
    "description": "add",
    "input_schema": {
     "type": "object",
     "properties": {
      "a": {
       "type": "number"
      },
      "b": {
       "type": "number"
      }
     },
     "required": [
      "a",
      "b"
     ]
    },
    "returns": 3
   }
  ],
  "program": "const a = await call(\"math.add\", {a: 1, b: 2}); const b = await ops.math.add({a: 1, b: 2}); [a, b, a === b]",
  "expect": {
   "result": [
    3,
    3,
    true
   ],
   "calls": {
    "math.add": 2
   },
   "exit": 0
  }
 },
 {
  "id": "op1-returns-promise",
  "spec": [
   "OP-1"
  ],
  "description": "an operation call returns a promise",
  "ops": [
   {
    "name": "math.add",
    "description": "add",
    "input_schema": {
     "type": "object",
     "properties": {
      "a": {
       "type": "number"
      },
      "b": {
       "type": "number"
      }
     },
     "required": [
      "a",
      "b"
     ]
    },
    "returns": 3
   }
  ],
  "program": "const p = call(\"math.add\", {a: 1, b: 2}); const t = typeof p.then; await p; t",
  "expect": {
   "result": "function",
   "exit": 0
  }
 },
 {
  "id": "op1-result-shapes",
  "spec": [
   "OP-1"
  ],
  "description": "operation results of every JSON shape come through unchanged",
  "ops": [
   {
    "name": "s.str",
    "description": "s",
    "returns": "text"
   },
   {
    "name": "s.num",
    "description": "s",
    "returns": 1.5
   },
   {
    "name": "s.nul",
    "description": "s",
    "returns": null
   },
   {
    "name": "s.arr",
    "description": "s",
    "returns": [
     1,
     [
      2
     ],
     {
      "a": null
     }
    ]
   },
   {
    "name": "s.obj",
    "description": "s",
    "returns": {
     "a": {
      "b": [
       1,
       2
      ]
     },
     "c": "d"
    }
   },
   {
    "name": "s.bool",
    "description": "s",
    "returns": false
   }
  ],
  "program": "[await ops.s.str(), await ops.s.num(), await ops.s.nul(), await ops.s.arr(), await ops.s.obj(), await ops.s.bool()]",
  "expect": {
   "result": [
    "text",
    1.5,
    null,
    [
     1,
     [
      2
     ],
     {
      "a": null
     }
    ],
    {
     "a": {
      "b": [
       1,
       2
      ]
     },
     "c": "d"
    },
    false
   ],
   "exit": 0
  }
 },
 {
  "id": "op1-args-omitted",
