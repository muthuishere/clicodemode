 {
  "id": "op2-enum",
  "spec": [
   "OP-2"
  ],
  "description": "enum restricts values",
  "ops": [
   {
    "name": "m.set",
    "description": "s",
    "input_schema": {
     "type": "object",
     "properties": {
      "mode": {
       "enum": [
        "fast",
        "slow"
       ]
      }
     },
     "required": [
      "mode"
     ]
    },
    "returns": "set"
   }
  ],
  "program": "const ok = await call(\"m.set\", {mode: \"fast\"}); let bad = \"no error\"; try { await call(\"m.set\", {mode: \"warp\"}) } catch (e) { bad = \"rejected\" } [ok, bad]",
  "expect": {
   "result": [
    "set",
    "rejected"
   ],
   "calls": {
    "m.set": 1
   },
   "exit": 0
  }
 },
 {
  "id": "op2-items",
  "spec": [
   "OP-2"
  ],
  "description": "items validates array elements",
  "ops": [
   {
    "name": "sum.all",
    "description": "s",
    "input_schema": {
     "type": "object",
     "properties": {
      "xs": {
       "type": "array",
       "items": {
