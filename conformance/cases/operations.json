    "returns": 3
   }
  ],
  "program": "let bad = \"no error\"; try { await call(\"sum.all\", {xs: [1, \"2\"]}) } catch (e) { bad = \"rejected\" } [await call(\"sum.all\", {xs: [1, 2]}), bad]",
  "expect": {
   "result": [
    3,
    "rejected"
   ],
   "calls": {
    "sum.all": 1
   },
   "exit": 0
  }
 },
