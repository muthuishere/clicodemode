[
 {
  "id": "lang2-generator-function",
  "spec": [
   "LANG-2"
  ],
  "description": "generator functions are rejected",
  "mode": "check",
  "program": "function* g() { yield 1 }",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 1,
     "col": 0,
     "messageContains": "generator"
    }
   ],
   "exit": 2
  }
 },
 {
  "id": "lang2-yield",
  "spec": [
   "LANG-2"
  ],
  "description": "yield is rejected as a generator construct",
  "mode": "check",
  "program": "const y = yield 1",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 1,
     "col": 11,
     "messageContains": "generator"
    }
   ],
   "exit": 2
  }
 },
 {
  "id": "lang2-delete",
  "spec": [
   "LANG-2"
  ],
  "description": "delete is a parse error on its own line",
  "mode": "check",
  "program": "const o = {a: 1}\ndelete o.a",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 2,
     "col": 1,
     "messageContains": "delete"
    }
   ],
   "exit": 2
  }
 },
 {
  "id": "lang2-dynamic-import",
  "spec": [
   "LANG-2"
  ],
  "description": "dynamic import() is a parse error",
  "mode": "check",
  "program": "const m = import('x')",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 1,
     "col": 11,
     "messageContains": "import"
    }
   ],
   "exit": 2
  }
 },
 {
  "id": "lang2-eval",
  "spec": [
   "LANG-2"
  ],
  "description": "eval is rejected before running",
  "mode": "check",
  "program": "eval(\"1 + 1\")",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 1,
     "col": 1,
     "messageContains": "eval"
    }
   ],
   "exit": 2
  }
 },
 {
  "id": "lang2-multiline-position",
  "spec": [
   "LANG-2"
  ],
  "description": "line numbers are 1-based and count newlines",
  "mode": "check",
  "program": "const a = 1\nconst b = 2\nfunction* g() {}",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 3,
     "col": 0,
     "messageContains": "generator"
    }
   ],
   "exit": 2
  }
 },
 {
  "id": "lang2-indented-position",
  "spec": [
   "LANG-2"
  ],
  "description": "columns are 1-based and count leading spaces",
  "mode": "check",
  "program": "function f(o) {\n    return delete o.x\n}",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 2,
     "col": 12,
     "messageContains": "delete"
    }
   ],
   "exit": 2
  }
 },
 {
  "id": "lang2-nothing-runs",
  "spec": [
   "LANG-2",
   "CLI-3"
  ],
  "description": "a program with an unsupported construct is never started, even when earlier statements are fine",
  "mode": "run",
  "ops": [
   {
    "name": "ok.op",
    "description": "ok"
   }
  ],
  "program": "await call(\"ok.op\")\ndelete input.x",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 2,
     "col": 1,
     "messageContains": "delete"
    }
   ],
   "calls": {
    "ok.op": 0
   },
   "exit": 2
  }
 },
 {
  "id": "lang2-eval-expression-unsupported",
  "spec": [
   "LANG-2",
   "CLI-3"
  ],
  "description": "eval of an expression with an unsupported construct fails with a diagnostic and nothing runs",
  "mode": "eval",
  "program": "delete input.x",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 1,
     "col": 1,
     "messageContains": "delete"
    }
   ],
   "exit": 2
  }
 },
 {
  "id": "lang2-for-await",
  "spec": [
   "LANG-2"
  ],
  "description": "for await is rejected",
  "mode": "check",
  "program": "async function f() { for await (const x of []) {} }",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 1,
     "messageContains": "for await"
    }
   ],
   "exit": 2
  }
 },
 {
  "id": "lang2-regex-lookahead",
  "spec": [
   "LANG-2",
   "LANG-7"
  ],
  "description": "regexes run on RE2: lookahead is a check error naming it",
  "mode": "check",
  "program": "const r = /a(?=b)/",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 1,
     "col": 11,
     "messageContains": "lookahead"
    }
   ],
   "exit": 2
  }
 },
 {
  "id": "lang2-regex-backreference",
  "spec": [
   "LANG-2",
   "LANG-7"
  ],
  "description": "backreferences are a check error",
  "mode": "check",
  "program": "const r = /(a)\\1/",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 1,
     "col": 11,
     "messageContains": "backreference"
    }
   ],
   "exit": 2
  }
 },
 {
  "id": "lang2-class-getter",
  "spec": [
   "LANG-2",
   "LANG-9"
  ],
  "description": "class getters, setters and private members are check errors",
  "mode": "check",
  "program": "class A {\n  get x() { return 1 }\n}",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 2,
     "col": 3,
     "messageContains": "getters"
    }
   ],
   "exit": 2
  }
 }
]
