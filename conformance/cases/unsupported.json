[
 {
  "id": "lang2-class",
  "spec": [
   "LANG-2"
  ],
  "description": "class is a parse error naming the construct",
  "mode": "check",
  "program": "class A {}",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 1,
     "col": 1,
     "messageContains": "class"
    }
   ],
   "exit": 2
  }
 },
 {
  "id": "lang2-new",
  "spec": [
   "LANG-2"
  ],
  "description": "new is a parse error at the keyword",
  "mode": "check",
  "program": "const d = new Date()",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 1,
     "col": 11,
     "messageContains": "new"
    }
   ],
   "exit": 2
  }
 },
 {
  "id": "lang2-this",
  "spec": [
   "LANG-2"
  ],
  "description": "this is a parse error at the keyword",
