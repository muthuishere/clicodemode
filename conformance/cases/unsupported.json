 {
  "id": "lang2-indented-position",
  "spec": [
   "LANG-2"
  ],
  "description": "columns are 1-based and count leading spaces",
  "mode": "check",
  "program": "function f() {\n    return new Thing()\n}",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 2,
     "col": 12,
     "messageContains": "new"
    }
   ],
   "exit": 2
  }
 },
 {
  "id": "lang2-nothing-runs",
  "spec": [
   "LANG-2",
   "CLI-3"
  ],
  "description": "a program with an unsupported construct is never started, even when earlier statements are fine",
  "mode": "run",
  "ops": [
   {
    "name": "ok.op",
    "description": "ok"
   }
  ],
  "program": "await call(\"ok.op\")\nclass A {}",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 2,
     "col": 1,
     "messageContains": "class"
    }
   ],
   "calls": {
    "ok.op": 0
   },
   "exit": 2
  }
 },
 {
  "id": "lang2-eval-expression-new",
  "spec": [
   "LANG-2",
   "CLI-3"
  ],
  "description": "eval of an expression with an unsupported construct fails with a diagnostic and nothing runs",
  "mode": "eval",
  "program": "new Date()",
  "expect": {
   "diagnostics": [
    {
     "severity": "error",
     "line": 1,
     "col": 1,
     "messageContains": "new"
    }
   ],
   "exit": 2
  }
 },
