{
  "name": "clicodemode",
  "version": "0.8.1",
  "description": "Code Mode for JS and TS CLIs: register your commands as operations, agents run a small JavaScript-like program that calls them. Engine is Go compiled to WASM.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codemode.wasm": "./dist/codemode.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/codemode.wasm",
    "README.md",
    "examples",
    "bin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:wasm": "bash ../scripts/build-wasm.sh",
    "test": "npm run build && node --test test/*.test.mjs",
    "verify-pack": "node scripts/verify-pack.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muthuishere/clicodemode.git",
    "directory": "npm"
  },
  "homepage": "https://muthuishere.github.io/clicodemode/",
  "bugs": {
    "url": "https://github.com/muthuishere/clicodemode/issues"
  },
  "bin": {
    "clicodemode-embed": "bin/clicodemode-embed.mjs"
  }
}
