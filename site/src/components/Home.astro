---
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';
import ProcessDiagram from './ProcessDiagram.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}`;
const GH = 'https://github.com/muthuishere/clicodemode';

const normalCalls = `aos window move Safari --zone=1A --monitor=2
aos display brightness 70
aos open https://youtube.com`;

const threeProcs = `await Promise.all([
  $\`aos window move Safari --zone=1A --monitor=2\`.nothrow(),
  $\`aos display brightness 70\`.nothrow(),
  $\`aos open https://youtube.com\`.nothrow(),
])`;

const oneProgram = `await Promise.all([
  ops["window-move"]({ args: ["Safari"], zone: "1A", monitor: 2 }),
  ops["display-brightness"]({ args: ["70"] }),
  ops.open({ args: ["https://youtube.com"] }),
])`;

const aosGo = `// internal/groups/code.go (verbatim)
func runCode(c *cli.Ctx, args []string) error {
	eng := newCodeEngine(c)
	cm := codemode.NewCLI(eng, "aos code")
	cm.Stdin, cm.Stdout, cm.Stderr = c.Stdin, c.Stdout, c.Stderr
	if code := cm.Main(context.Background(), args); code != 0 {
		return &cli.ExitError{Code: code}
	}
	return nil
}

func newCodeEngine(c *cli.Ctx) *codemode.Engine {
	reg := codemode.NewRegistry(c.Version)
	for _, op := range codeOperations(c) {
		reg.MustRegister(op)
	}
	eng := codemode.NewEngine(reg)
	eng.Stdout = c.Stderr // print() and console.log go to stderr, never into the result
	return eng
}`;

const aosHandler = `// codeHandler, abridged: the end of the returned func
		out := cli.Invoke(c, argv, "")
		if out.Exit != 0 {
			return nil, fmt.Errorf("exit %d: %s", out.Exit, codeTail(out.Stderr, out.Stdout))
		}
		var j any
		if json.Unmarshal([]byte(out.Stdout), &j) == nil && strings.TrimSpace(out.Stdout) != "" {
			return j, nil
		}
		return strings.TrimSpace(out.Stdout), nil`;

const aosProg = `const [wins, procs, disks, apps] = await Promise.all([
  ops["window-list"](), ops["process-list"]({ sort: "cpu", top: "5" }),
  ops["disk-list"](), ops["app-list"]({ running: true }),
])
;({ windows: wins.length, topCpu: procs.map(p => p.name), disks: disks.length, runningApps: apps.length })`;

const ctxGo = `// internal/app/codemode.go (abridged: three of six registrations shown)
func codeRegistry() *codemode.Registry {
	reg := codemode.NewRegistry(version.Version)
	ro := func(name, desc string, run cmdtree.Runner) {
		reg.MustRegister(cmdtree.FromRunner(name, desc, run,
			cmdtree.WithJSONResult("--json"),
			cmdtree.WithFlagsLast(), // these verbs parse positionals first
			cmdtree.WithValidate(validateFlags(name)),
			cmdtree.WithCheckResult(rejectFuzzy()),
			cmdtree.WithSideEffects(codemode.SideEffectNone)))
	}
	ro("ctx.query", "Find symbols/docs by 2-4 terms. args: [\\"<terms>\\", \\"--budget\\", \\"N\\"].",
		func(_ context.Context, a []string, o, e io.Writer) error { return cmdQuery(a, o, e) })
	ro("ctx.card", "Inspect one symbol: signature, doc, callers. args: [\\"<label>\\"].",
		func(_ context.Context, a []string, o, _ io.Writer) error { return cmdCard(a, o) })
	// ... ctx.change_plan, ctx.affected, ctx.path, ctx.hubs
	return reg
}`;

const ctxProg = `const q = await ops.ctx.query({ args: [input.terms, "--budget", "1500"] })
const hits = q.hits.slice(0, 3)
const cards = await Promise.all(hits.map(h => ops.ctx.card({ args: [h.node.label] })))
cards.map(c => ({ symbol: c.node.label, at: c.node.source + ":" + c.node.location, sig: c.signature }))`;

const ctxOut = `$ ctx-optimize code run - --input '{"terms":"change plan"}' --json < prog.js
{
  "ok": true,
  "value": [
    { "at": "internal/app/changeplan.go:L34-L45", "sig": "changePlan struct", "symbol": "changePlan" },
    { "at": "internal/app/changeplan.go:L55-L198",
      "sig": "func cmdChangePlan(args []string, stdout io.Writer) error", "symbol": "cmdChangePlan" },
    { "at": "internal/app/changeplan.go:L47-L51", "sig": "planConfidence struct", "symbol": "planConfidence" }
  ],
  "ms": 15
}`;

const qsInstall = `go get github.com/muthuishere/clicodemode@latest && go mod tidy`;
const qsRegister = `reg := codemode.NewRegistry("mycli 1.4.0")
reg.MustRegister(codemode.Operation{
	Name:        "health.check",
	Description: "Report whether this machine is healthy.",
	InputSchema: json.RawMessage(\`{"type":"object","properties":{"verbose":{"type":"boolean"}}}\`),
	SideEffects: codemode.SideEffectNone,
	Idempotent:  true,
	Handler: func(ctx context.Context, args map[string]any) (any, error) {
		return existingHealthCheck(args["verbose"] == true), nil // wrap, don't rewrite
	},
})`;
const qsWrap = `fs := flag.NewFlagSet("status", flag.ContinueOnError) // or your existing one
fs.Bool("short", false, "short output")
reg.MustRegister(cmdtree.FromFlagSet("repo.status", "Show repo status.", fs,
	func(ctx context.Context, args []string, stdout, stderr io.Writer) error {
		return runStatus(args, stdout) // existing command body, unchanged
	}))`;
const qsMount = `// in your command dispatch: mycli code <subcommand>
if len(os.Args) > 1 && os.Args[1] == "code" {
	os.Exit(codemode.NewCLI(codemode.NewEngine(reg), "mycli code").Main(ctx, os.Args[2:]))
}`;
const qsAgent = `mycli code capabilities --json      # operations, schemas, fingerprint to cache on
mycli code check prog.js            # file:line:col diagnostics; exit 2 and nothing runs
mycli code run - --input '{"verbose":true}' --json < prog.js
# {"ok": true, "value": ..., "ms": 3}`;
const qsCheck = `$ echo 'await ops.helth.check({})' | democli code check -
<stdin>:1:16: error: unknown operation "helth.check" (did you mean "health.check"?)
1 error(s)
$ echo $?
2`;
---

<div class="home not-content">
	<section class="hero">
		<p class="eyebrow"><span class="dot" aria-hidden="true"></span> Go library + Python, TypeScript, Rust <span class="sep">/</span> v0.6.2 <span class="sep">/</span> MIT</p>
		<h1 id="_top">Your agent has Code Mode. <span class="accent">Does your CLI?</span></h1>
		<p class="deck">
			Claude Code and OpenAI Codex can compose tool calls through generated programs. But if that code invokes a
			CLI five times, the CLI still starts five times. What if the CLI itself ran one program and called its
			registered operations in one process?
		</p>
		<p class="pitch">
			CLI CodeMode is an embeddable library for existing CLIs, in Go, with Python, TypeScript and Rust
			wrappers: register the commands you have, expose <code>code</code>, and agents send one program. It is not a new agent; it complements agent-side Code Mode.
		</p>
		<div class="ctas">
			<a class="btn primary" href={href('/getting-started/')}>Get started <span aria-hidden="true">→</span></a>
			<a class="btn" href={GH}>
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
				GitHub
			</a>
		</div>
		<div class="install">
			<Tabs syncKey="lang">
				<TabItem label="Go"><Code code={qsInstall} lang="sh" /></TabItem>
				<TabItem label="Python"><Code code="pip install clicodemode" lang="sh" /></TabItem>
				<TabItem label="TypeScript"><Code code="npm install clicodemode" lang="sh" /></TabItem>
				<TabItem label="Rust"><Code code="cargo add clicodemode" lang="sh" /></TabItem>
			</Tabs>
			<p class="install-note">Go is the native library. Python (Click, Typer, argparse), TypeScript and Rust run the same Go engine as WASM and are experimental: <a href={`${GH}/tree/main/python`}>python</a> · <a href={`${GH}/tree/main/npm`}>npm</a> · <a href={`${GH}/tree/main/rust`}>rust</a>.</p>
		</div>
	</section>

	<section class="band" aria-labelledby="h-compare">
		<p class="kicker">01 / The difference</p>
		<h2 id="h-compare">Three tool calls, one program, or one process?</h2>
		<p class="lede">Move a window, set the brightness, open a page. The work is the same. What changes is how many times the CLI boots.</p>
		<div class="split split3">
			<div class="col">
				<div class="col-h"><span class="tag">3 calls · 3 processes</span> normal mode</div>
				<Code code={normalCalls} lang="sh" title="3 Bash tool calls" wrap />
				<p class="note">The agent makes one tool call per command and reads each text output before the next. Every call starts <code>aos</code>.</p>
			</div>
			<div class="col">
				<div class="col-h"><span class="tag">1 program · 3 processes</span> agent Code Mode</div>
				<Code code={threeProcs} lang="js" title="Claude Code Code Mode program" wrap />
				<p class="note">One program instead of three tool calls, but each <code>$`aos …`</code> still starts <code>aos</code>, parses arguments and prints text.</p>
			</div>
			<div class="col">
				<div class="col-h"><span class="tag tag-accent">1 program · 1 process</span> CLI CodeMode</div>
				<Code code={oneProgram} lang="js" title="aos code run -" wrap />
				<p class="note">Checked first (<code>aos code check</code>: ok, 3 operations). The calls run in parallel inside one <code>aos</code> process; one JSON value comes back.</p>
			</div>
		</div>
		<div class="diagram"><ProcessDiagram />
		<p class="note">Observed on 2026-11-23 with Claude Code 2.1.330 and a wrapper that logs every <code>aos</code> start. Normal mode: three tool calls, three processes started one after another, 11 s for the whole turn. Code Mode on: one program, three processes started together, 2.1 s inside the program. <code>aos code run</code>: one process, 361 ms reported by aos. The times are measured at different points, so read them as a rough picture, not a benchmark. In every run the window move failed with "Accessibility permission denied", because the freshly downloaded aos binary had not been granted macOS Accessibility; brightness and open worked.</p></div>
	</section>

	<section class="band" aria-labelledby="h-real">
		<p class="kicker">02 / How we integrated</p>
		<h2 id="h-real">Two real CLIs, real code</h2>
		<p class="lede">aos ships it in v0.15.1 and ctx-optimize in v0.16.0. The Go excerpts are copied from that code; where code is left out, the excerpt says so.</p>
		<Tabs>
			<TabItem label="aos  (254 operations)">
				<div class="int-meta">
					<span class="status">shipped</span>
					<a href="https://github.com/muthuishere/aos/releases/tag/v0.15.1">aos v0.15.1</a>
									</div>
				<p>aos already had a batch table of every verb. <code>aos code</code> registers one operation per batch verb, and each handler calls the same <code>cli.Invoke</code> path, so the two can never disagree about what a command does. Results are JSON-first; a failing command throws.</p>
				<Code code={aosGo} lang="go" title="mount and register" />
				<Code code={aosHandler} lang="go" title="JSON-first handler" />
				<Code code={aosProg} lang="js" title="agent program: machine snapshot" />
				<p class="note">Measured: 220 ms wall, 260 ms CPU and 158 bytes back, vs 196 ms, 280 ms CPU and 8,612 bytes for four parallel processes. <a href={href('/examples/aos/')}>Full aos walkthrough</a></p>
			</TabItem>
			<TabItem label="ctx-optimize  (6 read-only verbs)">
				<div class="int-meta">
					<span class="status">shipped</span>
					<a href="https://github.com/muthuishere/ctx-optimize/releases/tag/v0.16.0">ctx-optimize v0.16.0</a>
					<span class="muted">npm <code>@muthuishere/ctx-optimize</code></span>
				</div>
				<p>ctx-optimize wraps its existing read-only verbs with <code>adapters/cmdtree</code>. <code>WithJSONResult</code> appends <code>--json</code> and returns the parsed value; <code>WithFlagsLast</code> handles verbs that read positionals first; <code>WithValidate</code> and <code>WithCheckResult</code> restate the front-door checks (unknown flags, fuzzy matches). Nothing that writes the store is registered.</p>
				<Code code={ctxGo} lang="go" title="internal/app/codemode.go" />
				<Code code={ctxProg} lang="js" title="agent program: query, then cards in parallel" />
				<Code code={ctxOut} lang="sh" title="structured output (real run on the ctx-optimize repo)" />
				<p class="note"><a href={href('/examples/ctx-optimize/')}>Full ctx-optimize walkthrough</a></p>
			</TabItem>
		</Tabs>
	</section>

	<section class="band" aria-labelledby="h-qs">
		<p class="kicker">03 / Quickstart</p>
		<h2 id="h-qs">Add <code>code</code> to a Go CLI</h2>
		<ol class="steps">
			<li>
				<h3>Register what you already have</h3>
				<p>Write a handler that calls your existing function, or wrap an existing command body with <code>adapters/cmdtree</code>. Both use the standard library only.</p>
				<Tabs>
					<TabItem label="New handler"><Code code={qsRegister} lang="go" /></TabItem>
					<TabItem label="Wrap a flag.FlagSet"><Code code={qsWrap} lang="go" /></TabItem>
				</Tabs>
			</li>
			<li>
				<h3>Mount the <code>code</code> subcommand</h3>
				<Code code={qsMount} lang="go" />
			</li>
			<li>
				<h3>Agents discover, check, then run</h3>
				<Code code={qsAgent} lang="sh" />
				<p>A typo is caught before anything runs:</p>
				<Code code={qsCheck} lang="sh" />
			</li>
		</ol>
		<p class="more"><a href={href('/getting-started/')}>Try the demo CLI in 30 seconds</a> <span aria-hidden="true">·</span> <a href={href('/integrate/')}>Integration guide</a></p>
	</section>

	<section class="band" aria-labelledby="h-who">
		<p class="kicker">04 / Who it is for</p>
		<h2 id="h-who">Built for two kinds of people</h2>
		<div class="cards">
			<a class="card" href={href('/integrate/')}>
				<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6l5 6-5 6M12 18h8" /></svg>
				<h3>CLI authors</h3>
				<p>You maintain a Go CLI and agents keep calling it one command at a time. Register your existing commands, mount <code>code</code>, and every agent gets self-describing operations, a checker and one-process runs. About 1.7 MB added to the binary.</p>
				<span class="go">Integrate your CLI →</span>
			</a>
			<a class="card" href={href('/agents/')}>
				<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4H6a2 2 0 00-2 2v4l-2 2 2 2v4a2 2 0 002 2h2M16 4h2a2 2 0 012 2v4l2 2-2 2v4a2 2 0 01-2 2h-2" /></svg>
				<h3>Agent skill developers</h3>
				<p>You write skills or prompts that drive CLIs. Any CLI with Code Mode answers <code>code capabilities --json</code>; your skill writes one program per task, checks it, runs it, and reads one JSON value back.</p>
				<span class="go">Use from an agent or skill →</span>
			</a>
		</div>
	</section>

	<section class="band" aria-labelledby="h-num">
		<p class="kicker">05 / Measurements</p>
		<h2 id="h-num">What we measured, and how</h2>
		<p class="lede">Same task both ways, medians, Apple Silicon, fresh process per run. "Separate processes" is how a Code Mode snippet calls a CLI today: one process per command. Model round trips are one either way; these numbers are about processes, CPU and bytes, not tokens.</p>
		<div class="tables">
			<div class="tbl">
				<h3>ctx-optimize: query, 5 cards, change plan (7 calls)</h3>
				<table>
					<thead><tr><th scope="col"></th><th scope="col">wall</th><th scope="col">CPU</th><th scope="col">bytes back</th></tr></thead>
					<tbody>
						<tr><th scope="row">7 processes, sequential</th><td>68 ms</td><td>167 ms</td><td>28,273</td></tr>
						<tr><th scope="row">7 processes, cards in parallel</th><td>47 ms</td><td>164 ms</td><td>28,273</td></tr>
						<tr class="hl"><th scope="row">1 <code>code run</code></th><td>33 ms</td><td>137 ms</td><td>169</td></tr>
					</tbody>
				</table>
			</div>
			<div class="tbl">
				<h3>aos: 24 read-only calls</h3>
				<table>
					<thead><tr><th scope="col"></th><th scope="col">wall</th><th scope="col">CPU</th></tr></thead>
					<tbody>
						<tr><th scope="row">24 processes, sequential</th><td>1,644 ms</td><td>1,228 ms</td></tr>
						<tr><th scope="row">24 processes, parallel</th><td>217 ms</td><td>1,493 ms</td></tr>
						<tr class="hl"><th scope="row">1 <code>code run</code></th><td>217 ms</td><td>1,012 ms</td></tr>
					</tbody>
				</table>
				<p class="note">Against parallel spawning the wall time is equal. The difference is CPU (about a third less) and what comes back.</p>
			</div>
		</div>
		<ul class="facts">
			<li><strong>Interpreter speed.</strong> A 1M-iteration loop takes 55 ms in CodeMode and 25 ms in Node. Node's JIT wins tight loops; put heavy compute in a Go operation.</li>
			<li><strong>Binary size.</strong> +1.7 MB to a stripped binary (2.5 MB to 4.2 MB). One dependency: <code>gopkg.in/yaml.v3</code>.</li>
			<li><strong>Not claimed.</strong> Token savings with a real agent have not been measured yet.</li>
		</ul>
		<p class="more"><a href={href('/benchmarks/')}>Benchmarks and methodology</a></p>
	</section>

	<section class="band last" aria-labelledby="h-next">
		<h2 id="h-next">Read next</h2>
		<div class="next">
			<a href={href('/how-it-works/')}><span>How it works</span><small>registry, engine, interpreter</small></a>
			<a href={href('/language/')}><span>JS subset</span><small>what programs can and cannot do</small></a>
			<a href={href('/security/')}><span>Security and policy</span><small>limits, Policy.Allow, not a sandbox</small></a>
			<a href={href('/faq/')}><span>FAQ</span><small>vs Claude Code Code Mode, MCP, shell scripts</small></a>
		</div>
	</section>
</div>

<style>
